# Entorno local: copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local a git.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# --- App ---
# URL pública final donde queda desplegada la app (usada para generar los QR
# y como base de redirección tras login/registro). Sin slash final.
NEXT_PUBLIC_APP_URL=https://pasaporte-wellsphere.vercel.app
